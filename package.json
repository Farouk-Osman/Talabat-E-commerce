{
  "name": "talabat-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack MEAN e-commerce app: Express API (server/) + Angular SPA (client/).",
  "license": "MIT",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run start:dev --workspace server",
    "dev:client": "npm run start --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start:prod --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:destroy": "npm run seed:destroy --workspace server",
    "lint": "npm run lint --workspace server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
