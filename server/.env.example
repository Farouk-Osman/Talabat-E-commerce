# Server
NODE_ENV=development
PORT=3000

# Database (required) — MongoDB connection string
DB_URI=mongodb://127.0.0.1:27017/talabat-api

# Auth (required) — use a long, random secret in production
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Uploads: "memory" (default) or "disk"
UPLOAD_STORAGE=memory

# Optional SMTP for password-reset emails. If unset, the reset code is logged
# to the server console in development instead of being emailed.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@example.com
